---
import { site, nav, type NavId } from '@/content/site';

interface Props {
  current?: NavId;
}
const { current } = Astro.props;

const linkMenu = 'font-body-sm text-body-sm px-space-md py-space-xs rounded-full transition-all duration-150';
const linkActivo = 'bg-primary text-on-primary font-semibold';
const linkNormal = 'text-on-surface-variant hover:text-on-surface';
const linkCodigo =
  'font-code-inline text-code-inline text-on-surface-variant hover:text-on-surface px-space-sm py-space-xs transition-colors';

// Estilos de los enlaces dentro del menú del celular
const linkMovil = 'block px-space-md py-space-sm rounded-lg font-body-md text-body-md transition-colors';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-surface/85 backdrop-blur-md shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
  <div class="h-20 max-w-[1280px] mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop flex items-center justify-between gap-space-md">
    <!-- Logo y nombre -->
    <a href="/" class="flex items-center gap-space-md min-w-max focus:outline-none focus:ring-1 focus:ring-secondary">
      <img src={site.logo} alt="Logo de Carlos Álvarez Carmona" class="h-8 w-auto object-contain" />
      <div class="flex flex-col">
        <span class="font-headline-sm text-headline-sm text-primary tracking-tight leading-tight">{site.nombre}</span>
        <span class="font-label-sm text-label-sm text-on-surface-variant font-medium">{site.puesto}</span>
      </div>
    </a>

    <!-- Menú principal (pantallas medianas y grandes) -->
    <nav class="hidden md:flex items-center bg-surface-container-low p-space-xs rounded-full shadow-[0_1px_3px_rgba(3,23,37,0.04)]">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={item.id === current ? 'page' : undefined}
          class:list={[linkMenu, item.id === current ? linkActivo : linkNormal]}
        >
          {item.texto}
        </a>
      ))}
    </nav>

    <!-- Enlaces de la derecha (solo pantallas grandes) -->
    <div class="hidden lg:flex items-center gap-space-xs">
      <a href="/#contacto" class={linkCodigo}>Contacto</a>
      {site.redes.map((red) => (
        <a href={red.url} target="_blank" rel="noopener noreferrer" class={linkCodigo}>{red.nombre}</a>
      ))}
      <a
        href={site.orcid.url}
        target="_blank"
        rel="noopener noreferrer"
        class="font-label-code text-label-code bg-surface-container-high text-primary px-space-xs py-0.5 rounded-DEFAULT tracking-wider font-semibold ml-space-xs"
      >
        ORCID
      </a>
    </div>

    <!-- Botón hamburguesa (se oculta en pantallas grandes) -->
    <button
      id="menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="lg:hidden w-10 h-10 rounded-lg flex items-center justify-center text-primary hover:bg-surface-container-high transition-colors focus:outline-none focus:ring-2 focus:ring-secondary"
    >
      <span class="material-symbols-outlined text-[26px]">menu</span>
    </button>
  </div>

  <!-- Panel desplegable -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden absolute top-full left-0 right-0 bg-surface border-t border-outline-variant/30 shadow-lg max-h-[calc(100vh-5rem)] overflow-y-auto"
  >
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-tablet py-space-md flex flex-col gap-space-xs">
      <!-- Estas páginas solo se muestran aquí cuando el menú principal está oculto (celular) -->
      <div class="md:hidden flex flex-col gap-space-xs pb-space-sm mb-space-xs border-b border-outline-variant/30">
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={item.id === current ? 'page' : undefined}
            class:list={[
              linkMovil,
              item.id === current
                ? 'bg-primary text-on-primary font-semibold'
                : 'text-on-surface hover:bg-surface-container-low',
            ]}
          >
            {item.texto}
          </a>
        ))}
      </div>

      <a href="/#contacto" class:list={[linkMovil, 'text-on-surface hover:bg-surface-container-low']}>
        Contacto
      </a>
      {site.redes.map((red) => (
        <a
          href={red.url}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[linkMovil, 'text-on-surface hover:bg-surface-container-low flex items-center gap-2']}
        >
          <span class="material-symbols-outlined text-[18px]">{red.icono}</span>
          {red.nombre}
        </a>
      ))}
      <a
        href={site.orcid.url}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[linkMovil, 'text-on-surface hover:bg-surface-container-low flex items-center gap-2']}
      >
        <span class="material-symbols-outlined text-[18px]">badge</span>
        ORCID
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement;
  const panel = document.getElementById('mobile-menu') as HTMLElement;
  const icon = toggle.querySelector('.material-symbols-outlined') as HTMLElement;
  const header = toggle.closest('header') as HTMLElement;

  const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

  function setOpen(open: boolean) {
    panel.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    icon.textContent = open ? 'close' : 'menu';
  }

  // Abrir / cerrar con el botón
  toggle.addEventListener('click', () => setOpen(!isOpen()));

  // Cerrar al elegir un enlace
  panel.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  // Cerrar al tocar fuera del encabezado
  document.addEventListener('click', (e) => {
    if (isOpen() && !header.contains(e.target as Node)) setOpen(false);
  });

  // Cerrar con la tecla Escape
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      toggle.focus();
    }
  });

  // Si la pantalla se agranda (ej: girar la tablet), se cierra solo
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>