---
interface Props {
  id?: string;
  tone?: 'plain' | 'soft'; // plain = fondo de la página, soft = fondo azul claro
  class?: string;
}
const { id, tone = 'plain', class: className } = Astro.props;
---

<section
  id={id}
  class:list={['w-full py-space-xl', tone === 'soft' && 'bg-surface-container-low', className]}
>
  <div class="max-w-[1280px] mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop">
    <slot />
  </div>
</section>