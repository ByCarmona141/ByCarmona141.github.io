---
import { certifications } from '@/content/certifications';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Card from '@/components/ui/Card.astro';
import Tag from '@/components/ui/Tag.astro';
---

<Section id="certificaciones" class="overflow-hidden">
  <SectionHeader
    eyebrow="Validación Profesional & Acreditaciones"
    title="Certificaciones & Credenciales Técnicas"
    description="Formación continua y acreditaciones en desarrollo de software, ciberseguridad, redes y sistemas Linux."
  />

  <!-- Carrusel infinito -->
  <div class="marquee-wrap relative w-full overflow-hidden py-4">
    <div class="animate-marquee">
      {[0, 1].map((copia) => (
        <div
          class="flex items-stretch gap-space-md flex-nowrap pr-space-md"
          aria-hidden={copia === 1 ? 'true' : undefined}
        >
          {certifications.map((c) => (
            <Card class="w-72 flex-shrink-0 p-5 border border-outline-variant/30 group">
              <div>
                <!-- Ícono + estado -->
                <div class="flex items-center justify-between mb-3">
                  <div class="w-10 h-10 rounded-lg bg-surface-container-high text-primary flex items-center justify-center shadow-sm">
                    {c.icon ? (
                      <img src={c.icon} alt="" loading="lazy" class="w-full h-full object-contain p-1.5" />
                    ) : (
                      <span class="material-symbols-outlined text-[22px]">workspace_premium</span>
                    )}
                  </div>
                  <span class="font-label-code text-[10px] px-2 py-0.5 rounded bg-emerald-400/15 text-[#0061a5] font-bold uppercase tracking-wider">
                    {c.status ? `${c.year} • ${c.status}` : c.year}
                  </span>
                </div>

                <span class="font-label-code text-[11px] text-secondary font-bold uppercase block mb-1">
                  {c.institution}
                </span>
                <h3 class="font-headline-sm text-[16px] text-primary font-bold mb-2 group-hover:text-secondary transition-colors">
                  {c.name}
                </h3>

                {c.credentialId && (
                  <div class="mb-3 bg-surface-container-low px-2 py-1 rounded border border-outline-variant/20 inline-block">
                    <span class="font-label-code text-[10px] text-on-surface-variant font-mono">ID: {c.credentialId}</span>
                  </div>
                )}

                {c.description && (
                  <p class="font-body-sm text-xs text-on-surface-variant mb-4">{c.description}</p>
                )}

                {c.tags && (
                  <div class="flex flex-wrap gap-1 mb-4">
                    {c.tags.map((tag) => <Tag size="sm">{tag}</Tag>)}
                  </div>
                )}
              </div>

              {c.credentialUrl && (
                <div class="pt-3 border-t border-outline-variant/20 flex items-center justify-between">
                  <a
                    href={c.credentialUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    tabindex={copia === 1 ? -1 : undefined}
                    class="font-code-inline text-xs text-secondary hover:text-primary font-semibold inline-flex items-center gap-1 transition-colors group-hover:underline"
                  >
                    <span>Verificar Credencial</span>
                    <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                  </a>
                  <span class="material-symbols-outlined text-secondary text-[18px]">verified</span>
                </div>
              )}
            </Card>
          ))}
        </div>
      ))}
    </div>
  </div>
</Section>

<style>
  /* Difumina los bordes izquierdo y derecho */
  .marquee-wrap {
    -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  }

  /* Movimiento continuo */
  @keyframes marquee {
    0%   { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    display: flex;
    width: max-content;
    animation: marquee 60s linear infinite;
  }

  /* Se detiene al pasar el mouse */
  .marquee-wrap:hover .animate-marquee {
    animation-play-state: paused;
  }
</style>