---
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { frontend } from '@/content/skills/frontend';
import { backend } from '@/content/skills/backend';
import { tools } from '@/content/skills/tools';
import type { Skill } from '@/content/skills/types';

// Texto pequeño debajo del nombre: "Avanzado · 4 años", "Relacional", etc.
function nota(s: Skill) {
  if (s.level && s.years) return `${s.level} · ${s.years} ${s.years === 1 ? 'año' : 'años'}`;
  return s.type ?? s.note ?? 'Herramienta';
}

// Junto todo en una sola lista para el carrusel
const stack: Skill[] = [
  ...backend.frameworks,
  ...backend.languages,
  ...frontend.frameworks,
  ...frontend.languages,
  ...backend.databases,
  ...tools.tools,
];
---

<Section class="overflow-hidden">
  <SectionHeader
    eyebrow="Arsenal Técnico"
    title="Stack de Especialización"
    description="Herramientas seleccionadas con rigor por su estabilidad operativa, rendimiento y capacidad de auditoría en entornos de misión crítica."
  />

  <div class="marquee-wrap relative w-full overflow-hidden py-2">
    <div class="animate-marquee items-center gap-space-sm">
      {[0, 1].map((copia) => (
        <div
          class="flex items-center gap-space-sm flex-nowrap"
          aria-hidden={copia === 1 ? 'true' : undefined}
        >
          {stack.map((item) => (
            <div
              class="w-44 bg-surface-container-low p-4 rounded-lg flex flex-col items-center justify-center text-center shadow-sm hover:bg-surface-container transition-colors flex-shrink-0"
            >
              <img src={item.icon} alt="" loading="lazy" class="w-8 h-8 object-contain mb-2" />
              <span class="font-headline-sm text-sm font-semibold text-primary">{item.name}</span>
              <span class="font-label-code text-[11px] text-secondary mt-1">{nota(item)}</span>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</Section>

<style>
  .marquee-wrap {
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  @keyframes marquee {
    0%   { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    display: flex;
    width: max-content;
    /* Antes 32s: ahora hay más tarjetas, así que lo hago más lento para que se pueda leer */
    animation: marquee 60s linear infinite;
  }

  .marquee-wrap:hover .animate-marquee {
    animation-play-state: paused;
  }
</style>